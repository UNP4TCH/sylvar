# ==============================================================================
# SYLVAR Backend Environment Configuration (.env.example)
# Copy this file to .env in backend/ (or project root) and populate with your credentials.
# Never commit real secrets to version control.
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development

# CORS Configuration: comma-separated list of allowed origins (never "*")
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (PostgreSQL with asyncpg required for production)
# Production MUST use the least-privilege runtime role 'sylvar_app_user' via Supavisor pooler (port 5432)
# In development, leave blank to use the local SQLite fallback (sqlite+aiosqlite:///./sylvar_dev.db)
DATABASE_URL=postgresql+asyncpg://sylvar_app_user:CHANGE_ME_DB_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Supabase Auth / JWT Verification Configuration
# When configuring Supabase Auth, both SUPABASE_URL and JWT_AUDIENCE must be set.
SUPABASE_URL=https://CHANGE_ME_PROJECT_REF.supabase.co
JWT_AUDIENCE=authenticated

# Optional JWT Verifier Overrides (defaults derived from SUPABASE_URL if omitted)
# JWT_ISSUER=https://CHANGE_ME_PROJECT_REF.supabase.co/auth/v1
# JWKS_URL=https://CHANGE_ME_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# JWT_ALGORITHMS=ES256,RS256

# Google Gemini API Configuration (for live factual and visual governance)
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash

# Safe Offline Demo Mode (strictly forbidden in production; default: false)
# Set to true only if running without live Gemini credentials for judging evaluation
ALLOW_OFFLINE_DEMO=false

