# ==============================================================================
# SYLVAR Frontend Environment Configuration (.env.example)
# Copy this file to .env in frontend/ and populate with your credentials.
# Only public/browser-safe variables belong here (VITE_* prefix).
# Never include database passwords or service-role keys.
# ==============================================================================

# API Backend Base URL
VITE_API_BASE_URL=http://localhost:8000

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://CHANGE_ME_PROJECT_REF.supabase.co

# Supabase Public Anon/Publishable Key (never the service-role key)
VITE_SUPABASE_ANON_KEY=CHANGE_ME_SUPABASE_ANON_KEY

